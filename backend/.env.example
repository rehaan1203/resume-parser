# Application
APP_NAME="Friction Matcher API"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO

# Domain Detection
DOMAIN_DETECTION_ENABLED=true
DOMAIN_UNKNOWN_THRESHOLD=10

# Gap Analysis
GAP_MINI_UPSKILL_THRESHOLD=90
GAP_SHORT_UPSKILL_THRESHOLD=70
GAP_STANDARD_UPSKILL_THRESHOLD=50

# Resources
MAX_RESOURCES_PER_DOMAIN=5
INCLUDE_YOUTUBE_RESOURCES=true
INCLUDE_CERTIFICATION_RESOURCES=true

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

# API
API_PREFIX="/api/v1"

# Mock Mode (Phase 2)
USE_MOCK=true

# AI Service (Phase 3 - Mistral)
USE_AI_SERVICE=true
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_ENDPOINT=https://api.mistral.ai
AI_MODEL=mistral-small-latest
# NOTE: Dedicated Codestral keys (starting with "mstrl_") ONLY authenticate against
# the Codestral endpoint. If using an mstrl_ key, you MUST configure:
# MISTRAL_ENDPOINT=https://codestral.mistral.ai
# AI_MODEL=codestral-latest

# AI Service Settings
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=45
AI_BACKOFF_FACTOR=2.0
MAX_EMBEDDING_BATCH_SIZE=100
MAX_TOKEN_LIMIT=8000

# Redis Cloud (Phase 4)
REDIS_URL=redis://username:password@redis-xxxxx.cloud.redislabs.com:xxxxx
REDIS_SSL=true
REDIS_POOL_SIZE=10
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5

# Cache TTLs (in seconds)
CACHE_TTL_EMBEDDINGS=3600      # 1 hour
CACHE_TTL_ANALYSIS=86400       # 24 hours
CACHE_TTL_JD=604800            # 7 days
CACHE_TTL_SESSION=3600         # 1 hour

# Cache Settings
CACHE_ENABLED=true
CACHE_WARMUP_ENABLED=true
CACHE_MAX_ENTRIES=1000

# Rate Limiting (Phase 4+)
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=100

# Link Verification - Performance
LINK_VERIFICATION_MAX_CONCURRENT=10
LINK_VERIFICATION_RETRY_ATTEMPTS=3
LINK_VERIFICATION_BACKOFF_FACTOR=2.0
LINK_VERIFICATION_SKIP_MAJOR_PLATFORMS=true
LINK_VERIFICATION_CACHE_TTL=3600

# Security
SECRET_KEY=your-secret-key-here

# Tools Configuration
TOOLS_ENABLED=true

# Tavily API (for course search)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_SEARCH_LIMIT=3

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_SEARCH_LIMIT=3

# Privacy (internal only - no UI)
PRIVACY_SCRUB_ENABLED=true

# Level 3: Self-Correction
SELF_CORRECTION_ENABLED=true
MAX_ITERATIONS=3
QUALITY_THRESHOLD=85

# Learning Memory
LEARNING_MEMORY_ENABLED=true
LEARNING_STORE_TYPE=file
LEARNING_STORE_PATH=./data/learning_memory.json

# Level 4: Tree of Thoughts
TREE_OF_THOUGHTS_ENABLED=true
NUM_PLANS=3
PLAN_EVALUATION_ACCURACY_WEIGHT=0.4
PLAN_EVALUATION_EFFICIENCY_WEIGHT=0.2
PLAN_EVALUATION_ROBUSTNESS_WEIGHT=0.2
PLAN_EVALUATION_INTERPRETABILITY_WEIGHT=0.2
PLAN_SELECTION_THRESHOLD=70
FALLBACK_TO_LEVEL3=true

# Level 5: Multi-Agent Collaboration
MULTI_AGENT_ENABLED=true
PARALLEL_AGENT_EXECUTION=true
MAX_AGENT_RETRIES=2

# Agent Timeouts
DOMAIN_AGENT_TIMEOUT=10
SKILLS_AGENT_TIMEOUT=15
SCORER_AGENT_TIMEOUT=10
CRITIC_AGENT_TIMEOUT=10
ROADMAP_AGENT_TIMEOUT=15

# Level 6: Continuous Learning
CONTINUOUS_LEARNING_ENABLED=true
FEEDBACK_COLLECTION_ENABLED=true
PATTERN_EXTRACTION_ENABLED=true
KNOWLEDGE_RETRIEVAL_ENABLED=true
MAX_PATTERNS_PER_TYPE=100
LEARNING_STORE_PATH=./data/learning_memory.json

# Feedback Settings
FEEDBACK_MIN_RATING=1
FEEDBACK_MAX_RATING=5
IMPLICIT_FEEDBACK_ENABLED=true
LEARNING_UPDATE_INTERVAL_HOURS=24

# Performance Tracking
PERFORMANCE_TRACKING_ENABLED=true
TRACK_ACCURACY_TREND=true
ACCURACY_WINDOW_DAYS=30

# Conditional Sections
CONDITIONAL_SECTIONS_ENABLED=true
MATCH_HIGH_THRESHOLD=60
MATCH_PARTIAL_THRESHOLD=20
MATCH_LOW_THRESHOLD=0

# Timeline Calculation
TIMELINE_30_DAY_MAX=30
TIMELINE_90_DAY_MAX=120
TIMELINE_TRANSITION_MIN=12
TIMELINE_TRANSITION_MAX=24

# RAG Knowledge Base (Stage 2 & Phase 3/4)
RAG_KNOWLEDGE_BASE_ENABLED=true
RAG_VECTOR_STORE_TYPE=memory
RAG_SIMILARITY_THRESHOLD=0.5
RAG_TOP_K=4

# Embedding Engine Provider: "deterministic" (zero-dependency hashing), 
# "local_sentence_transformer" (free all-MiniLM-L6-v2 on CPU), or "huggingface"
RAG_EMBEDDING_PROVIDER=deterministic

# Optional: Free Hugging Face Token (for cloud embeddings if not using local CPU model)
# Get a free key at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# Optional: Free Groq Cloud Key (Ultra-fast open-source Llama 3.3 / Mixtral inference)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Health Check & Self-Healing Automation
RAG_HEALTH_CHECK_INTERVAL_HOURS=24
RAG_AUTO_HEALTH_AUDIT_ON_STARTUP=false

# Microsoft Outlook / Azure AD Integration
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here
AZURE_OUTLOOK_EMAIL=friction.agent@yourdomain.com
OUTLOOK_AUTO_REPLY_ENABLED=true
OUTLOOK_AUTO_POLL_ENABLED=true
OUTLOOK_POLL_INTERVAL_SECONDS=45

# Microsoft SharePoint JD Integration
SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSiteName
SHAREPOINT_FOLDER_PATH=Shared Documents/JobDescriptions
SHAREPOINT_JD_CACHE_TTL_SECONDS=600
SHAREPOINT_AUTO_MATCH_BEST_FIT=true
